# Configuracion del servicio Missions.
# Se copia a `.env` para desarrollo local. `.env` esta ignorado por Git.
# Este archivo no contiene ni debe contener secretos reales.

# --- Servicio -------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=nexus-battle-missions
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
PORT=3007
GLOBAL_PREFIX=api

# Documentacion interactiva OpenAPI en /api/docs. Deshabilitada en produccion
# por defecto.
SWAGGER_ENABLED=true

# --- Persistencia ---------------------------------------------------------
# memory:   doble en proceso para desarrollo y pruebas. PROHIBIDO en produccion.
# postgres: PostgreSQL real; exige DATABASE_URL.
PERSISTENCE_DRIVER=memory
DATABASE_URL=

# --- Autenticacion --------------------------------------------------------
# disabled: se atribuye la identidad `anonymous`. Con NODE_ENV=production el
#           servicio NO ARRANCA en este modo (ADR-004).
# jwt:      se exige un testimonio de acceso firmado por el user pool.
AUTH_MODE=disabled

# No son secretos: el identificador del cliente publico viaja en la URL de
# inicio de sesion. Son los valores reales del pool aprovisionado.
COGNITO_USER_POOL_ID=us-east-1_HrEiSzzKW
COGNITO_CLIENT_ID=vqtjlpsemjr5kjtsb97fnr1qp

# --- Contrato interno entre servicios -------------------------------------
# Secreto HMAC compartido para `/api/internal/v1/...`. Sin el, las rutas
# internas responden 503. Consumidores autorizados (ADR-019): ninguno todavía.
# Missions tambien lo usa para firmar sus llamadas a Player/Inventory.
INTERNAL_SERVICE_AUTH_SECRET=

# --- Matricula (HU-70) ----------------------------------------------------
# Como se reserva al heroe (compromiso MISSION):
# memory: doble en proceso para desarrollo. PROHIBIDO en produccion.
# http:   Player/Inventory; exige PLAYER_INVENTORY_BASE_URL y el secreto interno.
#         Hasta que Player/Inventory publique la ruta, la matricula queda
#         PENDING y el jugador recibe 503.
# Sin valor: memory en desarrollo, http en produccion.
HERO_COMMITMENTS_DRIVER=memory
PLAYER_INVENTORY_BASE_URL=
# Tiempo maximo de cada llamada a otro servicio (100 a 30000 ms).
INTERNAL_HTTP_TIMEOUT_MS=3000

# Reintenta las matriculas PENDING con el mismo operationId y, pasados dos
# minutos, libera la reserva y las marca EXPIRED. Apagado por defecto.
ENROLLMENT_RECONCILER_ENABLED=false
ENROLLMENT_RECONCILER_INTERVAL_MS=15000

# Misiones de ejemplo del documento del curso (El Templo Olvidado y otra con
# requisito previo). Solo con PERSISTENCE_DRIVER=memory: no es contenido aprobado.
MISSIONS_EXAMPLE_CATALOG=false
